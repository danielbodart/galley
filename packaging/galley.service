# galley's window, started by its socket on the first question.
[Unit]
Description=galley's question queue
Requires=galley.socket
After=galley.socket graphical-session.target

[Service]
# Its settings are in ~/.config/galley/config.json. With none, it has no
# accessibility bus, through which any process in the session could press a
# button: {"accessibility": true} there turns it on, for a screen reader.
ExecStart=@daemon@
