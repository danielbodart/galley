# galley's window, started by its socket on the first question.
[Unit]
Description=galley's question queue
Requires=galley.socket
After=galley.socket graphical-session.target

[Service]
ExecStart=@daemon@
# No accessibility bus: any process in the session could press a button
# through it. Remove this line for a screen reader.
Environment=GTK_A11Y=none
